# Shared ignores (identical base in every Dialectic Playground repository).
# Python tooling (scripts, test runners, docs builds)
__pycache__/
*.py[cod]
.venv/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Repository-specific (Julia): coverage and allocation output, local preferences.
# Packages and precompiled caches live in the depot (JULIA_DEPOT_PATH), outside the tree.
*.jl.cov
*.jl.*.cov
*.jl.mem
LocalPreferences.toml
.julia/
